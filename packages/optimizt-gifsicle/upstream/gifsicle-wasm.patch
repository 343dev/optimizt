diff --git a/src/gifsicle_bridge.c b/src/gifsicle_bridge.c
new file mode 100644
index 0000000..cbae32d
--- /dev/null
+++ b/src/gifsicle_bridge.c
@@ -0,0 +1,241 @@
+/* gifsicle_bridge.c - Filesystem-free WebAssembly interface.
+   Copyright (C) 2026 Andrey Warkentin
+   SPDX-License-Identifier: GPL-2.0-only */
+
+#include <setjmp.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <lcdfgif/gif.h>
+#include "gifsicle.h"
+#include "gifsicle_bridge.h"
+
+#define ERROR_CAPACITY 4096
+
+static Gif_Record output_record;
+static char error_message[ERROR_CAPACITY];
+static size_t error_length;
+static jmp_buf allocation_jump;
+static int allocation_jump_active;
+static int serious_read_error;
+
+static void
+allocation_failed(void)
+{
+  if (allocation_jump_active)
+    longjmp(allocation_jump, 1);
+}
+
+void
+gifsicle_bridge_set_error(const char *message)
+{
+  error_length = 0;
+  error_message[0] = 0;
+  if (message)
+    gifsicle_bridge_append_error(message, strlen(message));
+}
+
+void
+gifsicle_bridge_append_error(const char *message, size_t length)
+{
+  size_t available = ERROR_CAPACITY - 1 - error_length;
+  if (length > available)
+    length = available;
+  if (length) {
+    memcpy(error_message + error_length, message, length);
+    error_length += length;
+    error_message[error_length] = 0;
+  }
+}
+
+static void
+bridge_read_error(Gif_Stream *gfs, Gif_Image *gfi,
+                  int is_error, const char *message)
+{
+  (void) gfs, (void) gfi;
+  if (is_error > 0)
+    serious_read_error = 1;
+  if (message)
+    gifsicle_bridge_set_error(message);
+}
+
+static void
+initialize_frame(Gt_Frame *frame, Gif_Stream *stream, Gif_Image *image)
+{
+  memset(frame, 0, sizeof(*frame));
+  frame->stream = stream;
+  frame->image = image;
+  frame->use = 1;
+  frame->interlacing = -1;
+  frame->left = -1;
+  frame->top = -1;
+  frame->delay = -1;
+  frame->disposal = -1;
+}
+
+static void
+initialize_output(Gt_OutputData *output, const Gifsicle_BridgeOptions *options)
+{
+  memset(output, 0, sizeof(*output));
+  output->screen_width = -1;
+  output->screen_height = -1;
+  output->loopcount = -2;
+  output->colormap_size = options->colors;
+  output->colormap_algorithm = COLORMAP_DIVERSITY;
+  output->dither_type = dither_none;
+  output->dither_name = "none";
+  output->colormap_gamma_type = options->gamma_type;
+  output->colormap_gamma = options->gamma;
+  output->optimizing = options->optimize;
+  output->scaling = GT_SCALING_NONE;
+  output->scale_method = SCALE_METHOD_MIX;
+}
+
+static int
+process(const uint8_t *data, uint32_t length,
+        const Gifsicle_BridgeOptions *options)
+{
+  Gif_Record input_record;
+  Gif_ReadLimits limits;
+  Gif_Stream *source;
+  Gif_Stream *result;
+  Gt_Frameset bridge_frames;
+  Gt_OutputData output_data;
+  int huge_stream = 0;
+  int compress_immediately;
+  int i;
+
+  input_record.data = data;
+  input_record.length = length;
+  limits.max_frames = GIFSICLE_BRIDGE_MAX_FRAMES;
+  limits.max_logical_area = GIFSICLE_BRIDGE_MAX_AREA;
+  limits.max_total_frame_area = GIFSICLE_BRIDGE_MAX_AREA;
+
+  no_warnings = 1;
+  error_count = 0;
+  serious_read_error = 0;
+  clp = 0;
+  set_diagnostic_handler(gifsicle_bridge_append_error);
+
+  source = Gif_FullReadRecordLimited(
+    &input_record,
+    GIF_READ_UNCOMPRESSED | GIF_READ_CONST_RECORD,
+    "<input>",
+    &limits,
+    bridge_read_error
+  );
+  if (!source
+      || source->read_status == GIF_READ_STATUS_LIMIT
+      || serious_read_error
+      || source->nimages == 0) {
+    Gif_DeleteStream(source);
+    set_diagnostic_handler(0);
+    return GIFSICLE_BRIDGE_INVALID_INPUT;
+  }
+
+  bridge_frames.count = source->nimages;
+  bridge_frames.cap = source->nimages;
+  bridge_frames.f = Gif_NewArray(Gt_Frame, source->nimages);
+  for (i = 0; i < source->nimages; ++i) {
+    initialize_frame(&bridge_frames.f[i], source, source->images[i]);
+    source->refcount++;
+    source->images[i]->refcount++;
+  }
+  source->refcount++;
+
+  initialize_output(&output_data, options);
+  Gif_InitCompressInfo(&gif_write_info);
+  gif_write_info.loss = options->lossy;
+  gif_write_info.flags = options->careful
+    ? GIF_WRITE_CAREFUL_MIN_CODE_SIZE | GIF_WRITE_EAGER_CLEAR : 0;
+
+  compress_immediately = options->optimize == 0
+    && options->colors == 0
+    && options->lossy == 0
+    && !options->careful;
+  result = merge_frame_interval(
+    &bridge_frames, 0, -1, &output_data, compress_immediately, &huge_stream
+  );
+  blank_frameset(&bridge_frames, 0, -1, 0);
+  Gif_DeleteArray(bridge_frames.f);
+  Gif_DeleteStream(source);
+
+  if (!result) {
+    set_diagnostic_handler(0);
+    return GIFSICLE_BRIDGE_PROCESSING_FAILED;
+  }
+
+  active_output_data = output_data;
+  kc_set_gamma(output_data.colormap_gamma_type, output_data.colormap_gamma);
+  if (output_data.colormap_size > 0)
+    gifsicle_apply_colormap(result);
+  if (output_data.optimizing & GT_OPT_MASK)
+    optimize_fragments(result, output_data.optimizing, huge_stream);
+
+  if (!Gif_FullWriteRecord(result, &gif_write_info, &output_record)) {
+    Gif_DeleteStream(result);
+    set_diagnostic_handler(0);
+    return GIFSICLE_BRIDGE_PROCESSING_FAILED;
+  }
+
+  Gif_DeleteStream(result);
+  set_diagnostic_handler(0);
+  return GIFSICLE_BRIDGE_OK;
+}
+
+void
+gifsicle_reset(void)
+{
+  Gif_FreeRecord(&output_record);
+  gifsicle_bridge_set_error(0);
+}
+
+int
+gifsicle_optimize(const uint8_t *data, uint32_t length,
+                   int optimize, int careful, int colors, int lossy,
+                   int gamma_type, double gamma)
+{
+  Gifsicle_BridgeOptions options;
+  int status;
+
+  gifsicle_reset();
+  options.optimize = optimize;
+  options.careful = careful;
+  options.colors = colors;
+  options.lossy = lossy;
+  options.gamma_type = gamma_type;
+  options.gamma = gamma;
+
+  Gif_SetAllocationFailureHandler(allocation_failed);
+  allocation_jump_active = 1;
+  if (setjmp(allocation_jump)) {
+    allocation_jump_active = 0;
+    Gif_SetAllocationFailureHandler(0);
+    gifsicle_bridge_set_error("WebAssembly memory allocation failed");
+    return GIFSICLE_BRIDGE_OUT_OF_MEMORY;
+  }
+
+  status = process(data, length, &options);
+  allocation_jump_active = 0;
+  Gif_SetAllocationFailureHandler(0);
+  return status;
+}
+
+const uint8_t *
+gifsicle_output_data(void)
+{
+  return output_record.data;
+}
+
+uint32_t
+gifsicle_output_size(void)
+{
+  return output_record.length;
+}
+
+
+const char *
+gifsicle_error_message(void)
+{
+  return error_message;
+}
