@@ -0,0 +1,34 @@
+/* gifsicle_bridge.h - Filesystem-free WebAssembly interface.
+   Copyright (C) 2026 Andrey Warkentin
+   SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef GIFSICLE_BRIDGE_H
+#define GIFSICLE_BRIDGE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <lcdfgif/gif.h>
+
+#define GIFSICLE_BRIDGE_MAX_FRAMES 100000U
+#define GIFSICLE_BRIDGE_MAX_AREA UINT64_C(134217728)
+
+enum {
+  GIFSICLE_BRIDGE_OK = 0,
+  GIFSICLE_BRIDGE_INVALID_INPUT = 1,
+  GIFSICLE_BRIDGE_PROCESSING_FAILED = 2,
+  GIFSICLE_BRIDGE_OUT_OF_MEMORY = 3
+};
+
+typedef struct {
+  int optimize;
+  int careful;
+  int colors;
+  int lossy;
+  int gamma_type;
+  double gamma;
+} Gifsicle_BridgeOptions;
+
+void gifsicle_bridge_set_error(const char *message);
+void gifsicle_bridge_append_error(const char *message, size_t length);
+
+#endif
diff --git a/src/gifwrite.c b/src/gifwrite.c
index a087a71..a737070 100644
--- a/src/gifwrite.c
+++ b/src/gifwrite.c
@@ -129,27 +129,53 @@ file_block_putter(const uint8_t *block, size_t size, Gif_Writer *grr)
 }
 
 
+static int
+memory_reserve(Gif_Writer *grr, size_t len)
+{
+  uint32_t cap;
+  uint8_t *v;
+  if (grr->errors)
+    return 0;
+  if (len > UINT32_MAX - grr->pos) {
+    grr->errors = 1;
+    return 0;
+  }
+  cap = grr->cap;
+  while (grr->pos + len > cap) {
+    if (cap == 0)
+      cap = 1024;
+    else if (cap > UINT32_MAX / 2)
+      cap = UINT32_MAX;
+    else
+      cap *= 2;
+    if (cap < grr->pos + len) {
+      grr->errors = 1;
+      return 0;
+    }
+  }
+  if (cap != grr->cap) {
+    v = Gif_Realloc(grr->v, sizeof(uint8_t), cap, __FILE__, __LINE__);
+    if (!v) {
+      grr->errors = 1;
+      return 0;
+    }
+    grr->v = v;
+    grr->cap = cap;
+  }
+  return 1;
+}
+
 static void
 memory_byte_putter(uint8_t b, Gif_Writer *grr)
 {
-  if (grr->pos >= grr->cap) {
-    grr->cap = (grr->cap ? grr->cap * 2 : 1024);
-    Gif_ReArray(grr->v, uint8_t, grr->cap);
-  }
-  if (grr->v) {
-    grr->v[grr->pos] = b;
-    grr->pos++;
-  }
+  if (memory_reserve(grr, 1))
+    grr->v[grr->pos++] = b;
 }
 
 static void
 memory_block_putter(const uint8_t *data, size_t len, Gif_Writer *grr)
 {
-  while (grr->pos + len >= grr->cap) {
-    grr->cap = (grr->cap ? grr->cap * 2 : 1024);
-    Gif_ReArray(grr->v, uint8_t, grr->cap);
-  }
-  if (grr->v) {
+  if (memory_reserve(grr, len)) {
     memcpy(grr->v + grr->pos, data, len);
     grr->pos += len;
   }
@@ -194,7 +220,7 @@ gif_writer_init(Gif_Writer* grr, FILE* f, const Gif_CompressInfo* gcinfo)
     grr->byte_putter = memory_byte_putter;
